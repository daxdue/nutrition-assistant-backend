datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum AbuseCategory {
  NOT_MEAL
  NUDITY
  SEXUAL_CONTENT
  VIOLENCE
  SELF_HARM
  HATE_SYMBOLS
  DRUGS
  WEAPON
  OTHER
}

model User {
  id               String        @id @default(uuid())
  telegramUserId   BigInt        @unique
  telegramUsername String?
  createdAt        DateTime      @default(now())

  status           UserStatus  @default(INACTIVE)

  dailySummaries   DailySummary[]
  garminDevices    GarminDevice[]
  foodEntries      FoodEntry[]
  abuseEvents      AbuseEvent[]
  pairingTokens    PairingToken[]
}

model FoodEntry {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String

  timestamp      DateTime
  imagePathOrUrl String
  captionText    String?
  aiParsedJson   Json?

  @@index([userId, timestamp])
}

model GarminDevice {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  deviceId  String   @unique
  apiKey    String   @unique
  model     String?
  firmwareVersion String?
  deviceName String?
  createdAt DateTime @default(now())
  
  @@index([apiKey])
}

model DailySummary {
  id                    String   @id @default(uuid())
  user                  User     @relation(fields: [userId], references: [id])
  userId                String
  date                  DateTime
  timezone              String?
  schemaVersion         String?
  dayStartTimestamp     DateTime?

  // movement
  steps                 Int?
  activeCaloriesKcal    Int?
  restingCaloriesKcal   Int?
  totalCaloriesBurned   Int?
  totalCaloriesKcal     Int?
  distanceCm            Int?
  floorsDescended       Int?
  floorsClimbed         Int?
  deviceBatteryPercent  Int?
  deviceMemoryFreeBytes Int?
  activeMinutesTotal    Int?
  activeMinutesVigorous Int?
  activeMinutesModerate Int?

  // heart / recovery
  bodyBatteryEvening    Int?
  bodyBatteryDailyStart Int?
  bodyBatteryDailyEnd   Int?
  bodyBatteryDailyMin   Int?
  bodyBatteryDailyMax   Int?
  bodyBatteryDailyCharged Int?
  bodyBatteryDailyDrained Int?
  bodyBatteryDailyNetChange Int?
  bodyBatteryDailySampleCount Int?

  stressAvg             Float?
  stressMin             Int?
  stressMax             Int?
  stressSampleCount     Int?
  heartRateAvgBpm       Int?
  heartRateMinBpm       Int?
  heartRateMaxBpm       Int?
  heartRateSampleCount  Int?
  spo2AvgPercent        Float?
  spo2MinPercent        Float?
  spo2MaxPercent        Float?
  spo2SampleCount       Int?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, date])
}

model AbuseEvent {
  id                    String            @id @default(uuid())
  user                  User?             @relation(fields: [userId], references: [id])
  userId                String?
  telegramUserId        BigInt
  category              AbuseCategory
  reason                String
  createdAt             DateTime          @default(now())
}

model PairingToken {
  id            String   @id @default(uuid())
  token         String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  expiresAt     DateTime
  used          Boolean  @default(false)
  createdAt     DateTime @default(now())
  
  @@index([token])
  @@index([userId, used])
}
