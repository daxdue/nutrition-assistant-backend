datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum AbuseCategory {
  NOT_MEAL
  NUDITY
  SEXUAL_CONTENT
  VIOLENCE
  SELF_HARM
  HATE_SYMBOLS
  DRUGS
  WEAPON
  OTHER
}

enum ActivityProvider {
  GARMIN
  STRAVA
  APPLE_HEALTH
  OTHER
}

enum ProviderAccountStatus {
  ACTIVE
  REVOKED
  EXPIRED
  ERROR
}

enum HydrationSource {
  MANUAL
  PROVIDER
}

enum HydrationTargetMode {
  MANUAL
  RECOMMENDED
}

enum HydrationStatus {
  ON_TRACK
  BEHIND
  AHEAD
  COMPLETE
}

model User {
  id               String        @id @default(uuid())
  telegramUserId   BigInt        @unique
  telegramUsername String?
  createdAt        DateTime      @default(now())

  status           UserStatus  @default(INACTIVE)
  timezone         String      @default("Europe/Istanbul")
  weightKg         Float?

  dailySummaries   DailySummary[]
  garminDevices    GarminDevice[]
  foodEntries      FoodEntry[]
  abuseEvents      AbuseEvent[]
  pairingTokens    PairingToken[]
  providerAccounts ProviderAccount[]
  providerIngestions ProviderIngestion[]
  hydrationSettings HydrationSettings?
  hydrationEntries  HydrationEntry[]
}

model FoodEntry {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String

  timestamp      DateTime
  imagePathOrUrl String
  captionText    String?
  aiParsedJson   Json?
  energyKcal     Int?
  proteinG       Float?
  carbsG         Float?
  fatG           Float?
  fiberG         Float?
  correctionCount Int @default(0)

  @@index([userId, timestamp])
}

model GarminDevice {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  deviceId  String   @unique
  apiKey    String   @unique
  model     String?
  firmwareVersion String?
  deviceName String?
  createdAt DateTime @default(now())
  
  @@index([apiKey])
}

model DailySummary {
  id                    String   @id @default(uuid())
  user                  User     @relation(fields: [userId], references: [id])
  userId                String
  date                  DateTime
  timezone              String?
  schemaVersion         String?
  dayStartTimestamp     DateTime?

  // provider metadata
  providersPresent      Json?
  providerPrimary       ActivityProvider?
  metricSources         Json?
  providerMetaJson      Json?

  // nutrition rollups
  mealsCount            Int?
  nutritionKcal         Int?
  nutritionProteinG     Float?
  nutritionCarbsG       Float?
  nutritionFatG         Float?
  nutritionFiberG       Float?
  firstMealAt           DateTime?
  lastMealAt            DateTime?
  missingMacrosCount    Int?
  netKcalEstimate       Int?
  notes                 String?

  // hydration
  hydrationTargetMl      Int?
  hydrationRecommendedMl Int?
  hydrationConsumedMl    Int?
  hydrationManualMl      Int?
  hydrationProviderMl    Int?
  hydrationStatus        HydrationStatus?
  hydrationTargetMode    HydrationTargetMode?
  temperatureAvgC        Float?
  temperatureMaxC        Float?

  // movement
  steps                 Int?
  activeCaloriesKcal    Int?
  restingCaloriesKcal   Int?
  totalCaloriesBurned   Int?
  totalCaloriesKcal     Int?
  distanceCm            Int?
  floorsDescended       Int?
  floorsClimbed         Int?
  deviceBatteryPercent  Int?
  deviceMemoryFreeBytes Int?
  activeMinutesTotal    Int?
  activeMinutesVigorous Int?
  activeMinutesModerate Int?

  // heart / recovery
  bodyBatteryEvening    Int?
  bodyBatteryDailyStart Int?
  bodyBatteryDailyEnd   Int?
  bodyBatteryDailyMin   Int?
  bodyBatteryDailyMax   Int?
  bodyBatteryDailyCharged Int?
  bodyBatteryDailyDrained Int?
  bodyBatteryDailyNetChange Int?
  bodyBatteryDailySampleCount Int?

  stressAvg             Float?
  stressMin             Int?
  stressMax             Int?
  stressSampleCount     Int?
  heartRateAvgBpm       Int?
  heartRateMinBpm       Int?
  heartRateMaxBpm       Int?
  heartRateSampleCount  Int?
  spo2AvgPercent        Float?
  spo2MinPercent        Float?
  spo2MaxPercent        Float?
  spo2SampleCount       Int?

  aiReport              DailyAiReport?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, date])
}

model HydrationSettings {
  id                      String              @id @default(uuid())
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String              @unique
  enabled                 Boolean             @default(false)
  targetMode              HydrationTargetMode @default(MANUAL)
  dailyTargetMl           Int?
  remindersEnabled        Boolean             @default(true)
  reminderIntervalMinutes Int                 @default(120)
  reminderStartHour       Int                 @default(9)
  reminderEndHour         Int                 @default(21)
  lastReminderAt          DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}

model HydrationEntry {
  id            String           @id @default(uuid())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  timestamp     DateTime
  volumeMl      Int
  source        HydrationSource
  provider      ActivityProvider?
  providerMeta  Json?
  createdAt     DateTime         @default(now())

  @@index([userId, timestamp])
}

model DailyAiReport {
  id             String       @id @default(uuid())
  dailySummary   DailySummary @relation(fields: [dailySummaryId], references: [id], onDelete: Cascade)
  dailySummaryId String       @unique

  model          String
  promptVersion  String
  inputJson      Json
  outputJson     Json
  messageText    String?
  sentAt         DateTime?

  createdAt      DateTime @default(now())
}

model ProviderAccount {
  id             String           @id @default(uuid())
  user           User             @relation(fields: [userId], references: [id])
  userId         String
  provider       ActivityProvider
  externalUserId String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String[]
  status         ProviderAccountStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  devices        ProviderDevice[]
  ingestions     ProviderIngestion[]

  @@unique([userId, provider])
  @@index([provider, externalUserId])
}

model ProviderDevice {
  id                String          @id @default(uuid())
  providerAccount   ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  providerAccountId String
  externalDeviceId  String?
  deviceApiKey      String?         @unique
  model             String?
  firmwareVersion   String?
  deviceName        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([providerAccountId, externalDeviceId])
  @@index([providerAccountId, externalDeviceId])
}

model ProviderIngestion {
  id                String           @id @default(uuid())
  provider          ActivityProvider
  user              User             @relation(fields: [userId], references: [id])
  userId            String
  providerAccount   ProviderAccount? @relation(fields: [providerAccountId], references: [id], onDelete: SetNull)
  providerAccountId String?
  payloadHash       String
  payloadJson       Json
  receivedAt        DateTime         @default(now())
  sourceTimestamp   DateTime?
  dayStartUtc       DateTime
  schemaVersion     String?
  status            String?
  errorMessage      String?

  @@index([userId, dayStartUtc])
  @@index([provider, payloadHash])
  @@unique([provider, userId, dayStartUtc, payloadHash])
}

model AbuseEvent {
  id                    String            @id @default(uuid())
  user                  User?             @relation(fields: [userId], references: [id])
  userId                String?
  telegramUserId        BigInt
  category              AbuseCategory
  reason                String
  createdAt             DateTime          @default(now())
}

model PairingToken {
  id            String   @id @default(uuid())
  token         String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  expiresAt     DateTime
  used          Boolean  @default(false)
  createdAt     DateTime @default(now())
  
  @@index([token])
  @@index([userId, used])
}
